# ==== IT Insights Lab — Bot Configuration ====
# Copy this file to .env and fill in real values.

# Bot token from @BotFather
BOT_TOKEN=1234567890:AAAA-your-token-here

# Main cohort group chat id (negative number, e.g. -1001234567890)
GROUP_CHAT_ID=-1001234567890

# Reviewers / admins group chat id (negative number)
REVIEW_CHAT_ID=-1009876543210

# Comma-separated Telegram user ids of admins
ADMIN_IDS=123456789

# Public invite link of the cohort group (https://t.me/+... or https://t.me/joinchat/...)
COHORT_GROUP_INVITE_LINK=https://t.me/+YourGroupInviteCode

# Mandatory Telegram channel username or link users must join before registration
REQUIRED_CHANNEL=@itinsights_lab
MANDATORY_CHANNEL=@itinsights_lab

# SQLite database file path (created automatically)
DATABASE_PATH=insights_lab.db

# Logging level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
